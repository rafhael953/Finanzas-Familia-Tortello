# Supabase: Project Settings -> API. La service role key SOLO va aca (server),
# nunca en el cliente ni en un repo publico.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Login de la app.
APP_USERS=tortello
APP_PASS=cambiaesto
APP_SECRET=cambiaesto-secreto

# Puerto para correr local (no aplica en Vercel).
PORT=3001
